# PY Connect backup configuration
# Copy to /etc/pyconnect/backup.env and fill in values
# sudo chmod 600 /etc/pyconnect/backup.env

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pondyconnect
DB_USER=pondyconnect
PGPASSWORD=CHANGE_ME

# GPG encryption recipient (key ID or email)
GPG_RECIPI=admin@pyconnect.in

# S3 cold storage (optional — leave empty to skip S3 upload)
S3_BUCKET=pyconnect-backups
AWS_CLI_PROFILE=default

# Local retention
RETENTION_DAYS=7
BACKUP_DIR=/var/backups/pyconnect
