root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true

[*.{json,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.csproj]
indent_style = space
indent_size = 2

# EF Core tooling generates these files; skip style/perf analyzers on them.
[**/Persistence/Migrations/**]
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA2225.severity = none

# Test projects use underscore-separated descriptive test names by convention.
[**/tests/**]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1031.severity = none