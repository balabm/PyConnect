# PY Connect Backend — Environment Variables Template
# Copy to .env and fill with REAL values. NEVER commit .env to version control.

# --- Docker Hub ---
DOCKERHUB_USERNAME=your-dockerhub-username

# --- Database (AWS RDS PostgreSQL) ---
ConnectionStrings__DefaultConnection=Host=your-rds-host.region.rds.amazonaws.com;Port=5432;Database=pondyconnect;Username=postgres;Password=CHANGE_ME_STRONG_PASSWORD
Database__Provider=PostgreSQL

# --- Redis ---
ConnectionStrings__Redis=redis:6379

# --- JWT (MUST be at least 32 characters of cryptographically random data) ---
# Generate with: openssl rand -base64 48
JWT_KEY=CHANGE_ME_TO_RANDOM_32_PLUS_CHARACTERS
JWT_ISSUER=https://pyconnect.run.place
JWT_AUDIENCE=https://pyconnect.run.place
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60

# --- SMS (Fast2SMS) ---
SMS_PROVIDER=Fast2SMS
SMS_USE_MOCK=false
SMS_API_KEY=YOUR_FAST2SMS_API_KEY

# --- Razorpay ---
PAYMENTS_USE_MOCK=false
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# --- WhatsApp Business API ---
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# --- Firebase (FCM Push Notifications) ---
# To enable: upload your Firebase service account JSON to the EC2 and mount it
# at /app/firebase-service-account.json, then set FIREBASE_IS_ENABLED=true
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json
FIREBASE_IS_ENABLED=false

# --- OSRM ---
OSRM_BASE_URL=https://router.project-osrm.org
